rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { 
      return request.auth != null; 
    }

    // Products collection (public read for WhatsApp catalog, authenticated write for POS stock decrement)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Sales & Checkout transactions
    match /sales/{saleId} {
      allow read, write: if isAuthenticated();
    }

    // Customers & VIP Accounts
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // Customer credit ledger & payments
    match /customerTransactions/{transId} {
      allow read, write: if isAuthenticated();
    }
    match /customerPayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    // Online Orders (public can create from catalog, authenticated can manage)
    match /onlineOrders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // User profiles & accounts
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Shift Handovers & Z-Reports
    match /shiftHandovers/{handoverId} {
      allow read, write: if isAuthenticated();
    }

    // Cash Reconciliations
    match /reconciliations/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Operating Expenses
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // Staff Attendance
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }

    // Deliveries & Logistics
    match /deliveries/{deliveryId} {
      allow read, write: if isAuthenticated();
    }

    // Store Settings & Config
    match /storeSettings/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback: allow authenticated store users read/write
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
